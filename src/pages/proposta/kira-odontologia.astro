  }
  .invest__linhas b { font-family: var(--font-mono); color: var(--text-1); font-weight: 500; white-space: nowrap; }
  .invest__sub-l { color: var(--text-3) !important; }
  .invest__desc { color: var(--gold-light) !important; }
  .invest__desc b { color: var(--gold-light) !important; }
  .invest__total { text-align: center; padding-top: 2rem; }
  .invest__total > span:first-child {
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--text-3);
  }
  .invest__valor {
    font-family: var(--font-display); font-weight: 700; line-height: 1;
    font-size: clamp(2.8rem, 8vw, 4.4rem); margin-top: 0.6rem;
    font-variant-numeric: tabular-nums;
  }
  .invest__cond { display: block; margin-top: 0.9rem; font-size: 0.88rem; color: var(--text-3); }
  .invest__nota {
    margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border);
    font-size: 0.9rem; line-height: 1.7; color: var(--text-2);
  }

  /* ---------- cta ---------- */
  .pcta { position: relative; z-index: 2; overflow: hidden; }
  .pcta__orb { bottom: -18%; left: 8%; width: 44vw; height: 44vw; max-width: 600px; max-height: 600px; background: var(--blue); }
  .cta { padding: clamp(2rem, 5vw, 3.4rem); }
  .cta__t { margin-top: 1.2rem; }
  .cta__passos { margin-top: 2rem; display: grid; gap: 1rem; max-width: 70ch; counter-reset: p; }
  .cta__passos li { font-size: 0.97rem; color: var(--text-2); line-height: 1.7; }
  .cta__actions { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; margin-top: 2.4rem; }
  .cta__mail { font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-3); }
  .cta__mail strong { color: var(--text-1); font-weight: 500; user-select: all; }

  /* ---------- rodapé ---------- */
  .pfoot { position: relative; z-index: 2; padding-block: 0 4rem; }
  .pfoot__in {
    display: flex; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap;
    font-size: 0.82rem; color: var(--text-3); line-height: 1.9;
  }
  .pfoot__r { text-align: right; }
  .pfoot a { color: var(--text-2); }
  .pfoot a:hover { color: var(--cyan-400); }

  /* ---------- responsivo ---------- */
  @media (max-width: 900px) {
    .phero__in { grid-template-columns: 1fr; }
