---
import Base from '../../layouts/Base.astro';

const WHATSAPP = '5511998002960';
const WHATSAPP_FMT = '(11) 99800-2960';
const WA_TEXT = encodeURIComponent('Olá, sou da Kira Odontologia e quero falar sobre a proposta.');
const waLink = `https://wa.me/${WHATSAPP}?text=${WA_TEXT}`;

const EMITIDA = '01 de outubro de 2026';
const VALIDA_ATE = '08/10/2026';

const entregas = [
  {
    n: '01',
    titulo: 'Página principal',
    preco: 'R$ 2.000',
    resumo:
      'A página que recebe quem chega pelo Google, quem clica na bio e quem recebeu o link de uma amiga. Refeita do começo, no mesmo endereço de hoje, com os textos escritos por nós.',
    destaques: [
      'Topo com uma frase, botão de WhatsApp e rota',
      'Um espaço próprio para cada tratamento',
      'Equipe com foto, nome, formação e CRO',
      'A clínica por dentro, com fotos reais',
    ],
    tudo: [
      'Topo de apresentação com WhatsApp de mensagem já escrita e botão de rota',
      'Um bloco por tratamento, ligado à página daquele tratamento que já existe',
      'Seção de equipe com foto, nome, formação e CRO de cada profissional',
      'Seção da clínica por dentro, com fotos reais no lugar da imagem gerada por computador',
      'Seção de perguntas frequentes',
      'Seção de localização, horário e estacionamento',
      'Botão de WhatsApp fixo em todas as páginas',
      'Formulário enxuto, com aviso de privacidade. Não pergunta sintoma nem histórico, porque informação de saúde é dado sensível pela LGPD',
      'Página de política de privacidade e aviso de cookies',
      'Rodapé com os dados obrigatórios do Conselho em campo editável',
      'Nome correto da clínica no Google e na aba do navegador',
      'Prévia com foto, nome e descrição ao compartilhar o link',
      'Ficha de negócio local que o Google lê e a paciente não vê',
      'Endereços antigos continuando a funcionar',
      'Medição de visitas do site, para vocês acompanharem',
      'Textos escritos pela NOVRA, com duas rodadas de ajuste incluídas',
      'Tratamento e organização de até 40 fotos que vocês já tiverem',
    ],
  },
  {
    n: '02',
    titulo: 'Blog',
    preco: 'R$ 1.500',
    resumo:
      'O post do Instagram some em dois dias. O artigo continua aparecendo meses depois, toda vez que alguém digita aquela dúvida no Google. Aqui não é criar um blog: é retomar o que já existe.',
    destaques: [
      'Os 10 artigos atuais aproveitados e reorganizados',
      'Endereço curto e fácil de divulgar',
      'Pauta inicial sugerida, dentro da norma',
      'Vocês publicam sozinhas depois',
    ],
    tudo: [
      'Blog reorganizado dentro do novo visual, com listagem por assunto',
      'Endereço curto e fácil de divulgar; o antigo passa a levar para o novo',
      'Os 10 artigos atuais levados para o site novo, com títulos e endereços arrumados',
      'Pauta inicial sugerida, com o ângulo “o que faz o preço variar”, já que o Conselho proíbe divulgar valor',
      'Diretriz editorial em uma página, incluindo a assinatura obrigatória por dentista com nome e registro',
      'Modelo de artigo já formatado',
      'Vídeo curto gravado ensinando a publicar',
    ],
  },
  {
    n: '03',
    titulo: 'Página de links da bio',
    preco: 'R$ 800',
    resumo:
      'O primeiro lugar onde cai quem viu um post e se interessou. Vocês já têm uma, e ela é a parte mais recente do site. É a peça que mais trabalha no dia a dia e precisa ser a mais rápida das três.',
    destaques: [
      'No endereço da clínica, não no de outra empresa',
      'Com a cara da marca, não um modelo genérico',
      'Mede qual botão as pessoas apertam',
      'Vocês editam sozinhas',
    ],
    tudo: [
      'Página de links no endereço da própria clínica, dentro de kiraodontologia.com.br',
      'Visual igual ao da clínica: mesmas cores, tipografia e fotos',
      'Botões principais já montados, com mensagem de WhatsApp pronta',
      'Contagem de cliques por botão, somada e sem identificar ninguém',
      'Edição pela própria equipe, sem abrir chamado com ninguém',
      'Construída leve, para abrir rápido no celular',
      'Vídeo curto gravado ensinando a atualizar a bio',
    ],
  },
];

const placar = [
  { num: '1', label: 'palavra no nome do seu site no Google', detalhe: 'O título é literalmente “Kira”. Sem odontologia, sem São Paulo, sem implante.' },
  { num: '0', label: 'prévia quando mandam seu link no WhatsApp', detalhe: 'Nenhuma foto, nenhum nome, nenhuma descrição. Chega um link azul seco.' },
  { count: 1.5, decimals: 1, suffix: ' MB', fallback: '1,5 MB', label: 'a imagem mais pesada da página inicial', detalhe: 'Sozinha, mais que a página inteira deveria pesar. E o nome do arquivo indica que ela foi gerada por computador.' },
  { count: 132, suffix: '', fallback: '132', label: 'dias sem um artigo novo no blog', detalhe: 'Os 10 artigos foram publicados todos no mesmo dia, 22 de maio de 2026.' },
];

const cases = [
  { img: 'akaki-site.webp', titulo: 'Página principal', desc: 'Topo com uma frase, agendamento e menu por tratamento.', url: 'https://akaki.odo.br/', label: 'akaki.odo.br', w: 1600, h: 1000 },
  { img: 'akaki-blog.webp', titulo: 'Blog', desc: 'Busca, filtro por assunto e artigos ligados aos tratamentos.', url: 'https://www.akaki.odo.br/blog/', label: 'akaki.odo.br/blog', w: 1600, h: 1000 },
  { img: 'akaki-bio.webp', titulo: 'Links da bio', desc: 'No domínio da clínica, com a identidade da marca.', url: 'https://link.bio.akaki.odo.br/', label: 'link.bio.akaki.odo.br', w: 860, h: 2130 },
];
---

<Base
  title="Proposta · Kira Odontologia · NOVRA"
  description="Proposta da NOVRA para refazer a página principal, o blog e a página de links da bio da Kira Odontologia."
  noindex={true}
>
  <header class="phead">
    <div class="container phead__in">
      <a href="/" class="phead__logo" aria-label="NOVRA">
        <img src="/brand/novra-logo-ui.png" alt="NOVRA" width="760" height="203" />
      </a>
      <p class="phead__meta">Proposta comercial · {EMITIDA}</p>
    </div>
  </header>

  <main id="main">

    <!-- ============ HERO ============ -->
    <section class="section phero">
      <span class="glow-orb phero__orb-a" aria-hidden="true"></span>
      <span class="glow-orb phero__orb-b" aria-hidden="true"></span>

      <div class="container phero__in">
        <div class="phero__copy">
          <span class="eyebrow" data-reveal>Para Kira Odontologia · Jardim Paulista · SP</span>
          <h1 class="h1 balance phero__title" data-reveal style="--reveal-delay: 90ms">
            No Google, o seu site hoje<br />se chama só <span class="text-gold">“Kira”</span>.
          </h1>
          <p class="lead pretty phero__lead" data-reveal style="--reveal-delay: 180ms">
            Proposta para refazer a página principal, o blog e a página de links da bio,
            como um projeto só, e dentro das regras de divulgação da odontologia.
          </p>

          <div class="phero__actions" data-reveal style="--reveal-delay: 260ms">
            <a href="#investimento" class="btn btn-primary btn-lg" data-magnetic>
              Ver a proposta
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href={waLink} target="_blank" rel="noopener" class="btn btn-ghost btn-lg" data-magnetic>Falar no WhatsApp</a>
          </div>
        </div>

        <!-- prova visual: como a clínica aparece no Google hoje -->
        <div class="serp" data-reveal style="--reveal-delay: 340ms" aria-label="Simulação de como o site da clínica aparece hoje numa busca do Google">
          <div class="serp__chrome" aria-hidden="true">
            <span class="serp__dot"></span><span class="serp__dot"></span><span class="serp__dot"></span>
            <span class="serp__tab">Kira</span>
          </div>
          <div class="serp__body">
            <p class="serp__url">kiraodontologia.com.br</p>
            <p class="serp__title">Kira</p>
            <p class="serp__desc"><span class="serp__missing">sem descrição</span></p>
            <hr class="hairline" />
            <p class="serp__note">
              É assim que a clínica se apresenta a quem ainda não conhece vocês.
            </p>
          </div>
        </div>
      </div>

      <div class="container">
        <dl class="facts" data-reveal style="--reveal-delay: 420ms">
          <div class="facts__i"><dt>Escopo</dt><dd>3 entregas</dd><span>Principal · Blog · Bio</span></div>
          <div class="facts__i"><dt>Prazo</dt><dd>2 semanas</dd><span>a partir do material</span></div>
          <div class="facts__i"><dt>Validade</dt><dd>{VALIDA_ATE}</dd><span>7 dias</span></div>
        </dl>
      </div>
    </section>

    <!-- ============ DIAGNÓSTICO ============ -->
    <section class="section pdiag">
      <div class="container">
        <div class="section-head" data-reveal>
          <span class="eyebrow">O que está no ar hoje</span>
          <span class="signature-line signature-line--sm head-sig" aria-hidden="true"></span>
          <h2 class="h2 balance">Quatro coisas objetivas. Dá para <span class="text-gradient">conferir agora.</span></h2>
          <p class="lead pretty">
            Nada aqui é opinião de gosto, e nada aqui é crítica a quem fez o site antes.
            Foi tudo verificado direto no site no ar em 1º de outubro de 2026.
          </p>
        </div>

        <ul class="placar">
          {placar.map((p, i) => (
            <li class="placar__i card card-accent" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
              <i class="card-halo" aria-hidden="true"></i>
              <p class="placar__num text-silver">
                {p.count !== undefined
                  ? <span data-count={p.count} data-decimals={p.decimals ?? 0} data-suffix={p.suffix ?? ''}>{p.fallback}</span>
                  : p.num}
              </p>
              <p class="placar__label">{p.label}</p>
              <p class="placar__det">{p.detalhe}</p>
            </li>
          ))}
        </ul>

        <figure class="evid" data-reveal>
          <img src="/proposta/kira/kira-equipe-hoje.webp" alt="Página Sobre da Kira Odontologia com quatro cartões de equipe vazios, escritos “Nome Sobrenome” e “Cargo”." width="1100" height="414" loading="lazy" />
          <figcaption>
            <strong>kiraodontologia.com.br/sobre</strong>, hoje, no ar. Os quatro espaços da equipe
            estão com o texto de rascunho. É a página que mais pesa quando alguém está decidindo
            fazer um implante: a pessoa quer saber quem vai mexer na boca dela.
          </figcaption>
        </figure>

        <p class="pdiag__close lead pretty" data-reveal>
          A procura existe: 8 em cada 10 pacientes pesquisam no Google antes de escolher um dentista
          <em>(Simples Dental, agosto de 2026)</em>. A reputação existe: <strong class="text-bright">4,9 no Google</strong>,
          com quase 300 avaliações. Isso não se compra. O que falta é o site estar à altura disso.
        </p>
      </div>
    </section>

    <!-- ============ ENTREGAS ============ -->
    <section class="section pentregas">
      <span class="glow-orb pentregas__orb" aria-hidden="true"></span>
      <div class="container">
        <div class="section-head" data-reveal>
          <span class="eyebrow">O que entregamos</span>
          <span class="signature-line signature-line--sm head-sig" aria-hidden="true"></span>
          <h2 class="h2 balance">Três entregas, <span class="text-gradient">um projeto só.</span></h2>
          <p class="lead pretty">
            Vocês já têm site, blog e bio. Por isso esta proposta não fala em criar nada do zero.
            Ela refaz os três pontos que carregam a primeira impressão, com a mesma identidade,
            as mesmas fotos e o mesmo jeito de escrever.
          </p>
        </div>

        <div class="ent__grid">
          {entregas.map((e, i) => (
            <article class="ent card card-accent" data-reveal style={`--reveal-delay: ${i * 110}ms`}>
              <i class="card-halo" aria-hidden="true"></i>
              <div class="ent__top">
                <span class="ent__n">{e.n}</span>
                <span class="ent__preco">{e.preco}</span>
              </div>
              <h3 class="ent__titulo">{e.titulo}</h3>
              <p class="ent__resumo">{e.resumo}</p>
              <ul class="ent__dest">
                {e.destaques.map((d) => <li>{d}</li>)}
              </ul>
              <details class="disc ent__disc">
                <summary>Ver tudo que entra <span class="disc__c" aria-hidden="true"></span></summary>
                <ul class="disc__list">
                  {e.tudo.map((t) => <li>{t}</li>)}
                </ul>
              </details>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CASE AKAKI ============ -->
    <section class="section pcase">
      <div class="container">
        <div class="section-head" data-reveal>
          <span class="eyebrow">Já fizemos exatamente isto</span>
          <span class="signature-line signature-line--sm head-sig" aria-hidden="true"></span>
          <h2 class="h2 balance">Akaki Odontologia: <span class="text-gold">as mesmas três peças.</span></h2>
          <p class="lead pretty">
            Clínica em Jardim América, São Paulo. Página principal, blog e página de links da bio,
            construídos como um projeto só. Está tudo no ar: abra e navegue.
          </p>
        </div>

        <div class="case__grid">
          {cases.map((c, i) => (
            <a class="case card" href={c.url} target="_blank" rel="noopener" data-reveal data-tilt style={`--reveal-delay: ${i * 110}ms`}>
              <i class="card-halo" aria-hidden="true"></i>
              <span class="case__shot"><img src={`/proposta/kira/${c.img}`} alt={`${c.titulo} da Akaki Odontologia`} width={c.w} height={c.h} loading="lazy" /></span>
              <h3 class="case__t">{c.titulo}</h3>
              <p class="case__d">{c.desc}</p>
              <span class="link-arrow case__l">
                {c.label}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ INVESTIMENTO ============ -->
    <section class="section pinvest" id="investimento">
      <span class="glow-orb pinvest__orb" aria-hidden="true"></span>
      <div class="container">
        <div class="invest card" data-reveal>
          <i class="card-halo" aria-hidden="true"></i>
          <div class="invest__head">
            <span class="eyebrow">Investimento</span>
            <p class="invest__sub">Projeto fechado. Sem mensalidade, sem taxa de manutenção.</p>
          </div>

          <ul class="invest__linhas">
            <li><span>Página principal</span><b>R$ 2.000,00</b></li>
            <li><span>Blog</span><b>R$ 1.500,00</b></li>
            <li><span>Página de links da bio</span><b>R$ 800,00</b></li>
            <li class="invest__sub-l"><span>Subtotal</span><b>R$ 4.300,00</b></li>
            <li class="invest__desc"><span>Desconto por fechar as três juntas · 12%</span><b>− R$ 516,00</b></li>
          </ul>

          <div class="invest__total">
            <span>Total</span>
            <p class="invest__valor text-silver">R$ <span data-count="3784" data-decimals="0">3.784</span>,00</p>
            <span class="invest__cond">à vista, na assinatura · proposta válida até {VALIDA_ATE}</span>
          </div>

          <p class="invest__nota">
            <strong class="text-bright">Por que existe o desconto:</strong> os três são o mesmo projeto.
            Feitos juntos, compartilham a mesma identidade, as mesmas fotos e o mesmo jeito de escrever,
            e isso economiza trabalho de verdade. Feitos separados, esse ganho não existe.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ O COMBINADO (tudo que protege, em acordeão) ============ -->
    <section class="section pcomb">
      <div class="container">
        <div class="section-head" data-reveal>
          <span class="eyebrow">O combinado</span>
          <span class="signature-line signature-line--sm head-sig" aria-hidden="true"></span>
          <h2 class="h2 balance">Sem surpresa no meio do caminho.</h2>
          <p class="lead pretty">
            Está tudo escrito. Abra o que quiser conferir: prazo, regras do Conselho,
            o que está incluso, o que não está e de que o cronograma depende.
          </p>
        </div>

        <div class="comb" data-reveal>

          <details class="disc">
            <summary>Como trabalhamos, etapa por etapa <span class="disc__c" aria-hidden="true"></span></summary>
            <div class="disc__body">
              <ol class="etapas">
                <li><b>1. Diagnóstico</b> · Dia 1. Reunião de cerca de uma hora e levantamento do que já existe, página por página. Confirmamos nomes, formações e registros da equipe, inscrição da clínica e do responsável técnico, quais tratamentos entram e como são nomeados, e quais acessos precisamos.</li>
                <li><b>2. Desenho das páginas e textos</b> · Dias 2 a 4. Desenhamos as páginas no papel antes de programar e escrevemos os textos. <b>Primeira aprovação de vocês</b> no dia 5, e é aqui que fica a primeira das duas rodadas de ajuste incluídas.</li>
                <li><b>3. Desenvolvimento</b> · Dias 6 a 8. Construímos as três peças sobre a mesma base. Vocês acompanham por um link de prévia.</li>
                <li><b>4. Conferência e publicação</b> · Dias 9 e 10. <b>Segunda aprovação de vocês</b>, cópia de segurança do site antigo e virada em janela combinada, sem a clínica ficar fora do ar. Conferimos tudo no celular antes de liberar.</li>
                <li><b>5. Acompanhamento e treinamento</b> · Depois de publicar. Corrigimos o que aparecer nos primeiros 30 dias e entregamos o treinamento em vídeo gravado, que fica com vocês, mais uma conversa de meia hora ao vivo.</li>
              </ol>
              <p class="disc__fine">
                São 10 dias úteis de trabalho nosso, e eles só correm com duas condições: o material da
                clínica chega completo no dia 1 e cada uma das duas aprovações volta em até 1 dia útil.
                Cada dia de espera por material ou por aprovação empurra a entrega no mesmo tanto, e isso
                é dito agora para a data combinada ser real. Se a espera passar de 10 dias corridos, o
                projeto é pausado e reagendado na primeira janela livre, sem alteração do valor, desde que
                a retomada aconteça dentro de 90 dias.
              </p>
            </div>
          </details>

          <details class="disc">
            <summary>Dentro das regras da odontologia <span class="disc__c" aria-hidden="true"></span></summary>
            <div class="disc__body">
              <p>Odontologia tem regras próprias de divulgação, e elas valem igual para site, blog e página de links. O site da Kira nasce dentro delas. Essa parte é nosso trabalho e já sai pronta.</p>
              <p>Entram por obrigação: nome e inscrição da clínica no Conselho, nome e registro do responsável técnico, a identificação de Cirurgião-Dentista e, se o site citar especialidades, a relação dos profissionais com as suas qualificações. Esses dados ficam em campo editável, e não travados dentro do site, porque o responsável técnico pode mudar.</p>
              <p class="disc__sub">Fica de fora do site, de propósito:</p>
              <ul class="disc__list disc__list--no">
                <li>preço, tabela ou “a partir de R$”</li>
                <li>parcelamento e forma de pagamento</li>
                <li>“avaliação gratuita” ou “primeira consulta grátis”</li>
                <li>promessa de resultado, do tipo “sorriso perfeito garantido”</li>
                <li>“a melhor da região”, “referência em”</li>
                <li>foto de equipamento ou instrumental identificável, e vídeo durante o procedimento</li>
                <li>a palavra “popular”, que a norma proíbe pelo nome</li>
              </ul>
              <p class="disc__sub">Três pontos que passam pela responsável técnica antes de ir ao ar:</p>
              <ul class="disc__list">
                <li><b>Como cada tratamento é nomeado.</b> Termos comerciais muito usados, como “lente de contato dental”, são questionados pelo Conselho. Nossa recomendação é usar o nome técnico com o popular entre parênteses.</li>
                <li><b>Quais tratamentos entram.</b> Alguns, como sedação, exigem habilitação específica e só podem ser divulgados com o profissional habilitado identificado.</li>
                <li><b>Antes e depois.</b> Pela nossa leitura, é conteúdo do dentista que executou, no perfil dele, com autorização escrita da paciente e registro na imagem. Não é conteúdo da clínica. Por isso não prevemos galeria de resultados. Se o entendimento da responsável técnica for outro, o espaço se adapta.</li>
              </ul>
              <p class="disc__fine">
                Base: Código de Ética Odontológica (Resolução CFO-118/2012) e Resolução CFO-196/2019, com as
                atualizações publicadas em 2025. A responsabilidade perante o Conselho pelo que está publicado
                recai sobre a clínica e o responsável técnico. Por isso entregamos o site já dentro da norma, e
                por isso a validação final de qualquer conteúdo, inclusive da mensagem pronta do botão de
                WhatsApp, é sempre da responsável técnica. A NOVRA não é escritório jurídico.
              </p>
            </div>
          </details>

          <details class="disc">
            <summary>O que está incluso e o que não está <span class="disc__c" aria-hidden="true"></span></summary>
            <div class="disc__body">
              <div class="duo">
                <div>
                  <p class="disc__sub disc__sub--yes">Está incluso</p>
                  <ul class="disc__list">
                    <li>As três peças refeitas, com os textos escritos pela NOVRA. Vocês não recebem um site vazio para preencher</li>
                    <li>Tratamento e organização de até 40 fotos que vocês já tiverem</li>
                    <li>Equipe com foto, nome, formação e registro de cada profissional</li>
                    <li>Dados obrigatórios do Conselho em campo editável</li>
                    <li>Política de privacidade e aviso de cookies</li>
                    <li>WhatsApp fixo com mensagem pronta, mapa, horário e como chegar</li>
                    <li>Formulário enxuto entregando as mensagens no e-mail e no WhatsApp que vocês indicarem</li>
                    <li>Prévia com foto e descrição ao compartilhar o link</li>
                    <li>Medição de visitas no site e contagem de cliques na bio</li>
                    <li>Endereços antigos continuando a funcionar</li>
                    <li>Cópia de segurança do site atual antes da virada</li>
                    <li>Duas rodadas de ajuste e correção de defeito por 30 dias após a publicação</li>
                    <li>Treinamento em vídeo, conversa de meia hora ao vivo, modelo de artigo e diretriz editorial</li>
                  </ul>
                </div>
                <div>
                  <p class="disc__sub disc__sub--no">Não está incluso</p>
                  <ul class="disc__list disc__list--no">
                    <li>O cuidado do Perfil da Empresa no Google. A honestidade aqui: o que mais pesa na escolha da paciente é a avaliação de outros pacientes, e isso vive no perfil do Google, não no site. Orientamos sem cobrar, e não vendemos como entrega o que ele entrega.</li>
                    <li>Reescrita das páginas internas de cada tratamento. Elas continuam no ar com o visual atual, ligadas à nova página principal. Dizemos agora para não haver surpresa na entrega.</li>
                    <li>Produção de artigos novos depois da entrega</li>
                    <li>Gestão de Instagram, anúncios pagos e disparo de mensagens</li>
                    <li>Sessão de fotos profissional. Entregamos o roteiro do que pode e do que não pode aparecer, pela norma do Conselho, antes de vocês contratarem o fotógrafo.</li>
                    <li>Sistema de agendamento, atendimento automático e painéis de acompanhamento</li>
                    <li>Validação jurídica da política de privacidade e aprovação final do conteúdo pelo responsável técnico</li>
                    <li>Domínio e hospedagem, que continuam no nome da clínica. A NOVRA não cobra nada por isso e não entra nessa relação.</li>
                    <li>Banco de imagens, fontes pagas ou ferramentas pagas</li>
                    <li>Mudanças pedidas depois da segunda aprovação, fora das duas rodadas incluídas</li>
                    <li>Promessa de posição no Google, número de visitas ou quantidade de pacientes</li>
                  </ul>
                </div>
              </div>
              <p class="disc__fine">
                O que conta como defeito nos 30 dias de garantia: qualquer coisa entregue por nós que não
                funcione como combinado: link quebrado, bloco que não abre no celular, formulário que não
                chega, texto trocado. Não conta: mudança de ideia sobre conteúdo ou visual, problema causado
                por edição feita pela própria equipe depois da entrega, e queda ou lentidão da hospedagem,
                que é contratada pela clínica.
              </p>
            </div>
          </details>

          <details class="disc">
            <summary>De que o prazo depende <span class="disc__c" aria-hidden="true"></span></summary>
            <div class="disc__body">
              <ul class="disc__list">
                <li><b>Acesso ao site e ao domínio liberado no dia 1.</b> É o ponto que mais trava projeto de troca de site. O domínio e a hospedagem são de vocês, então o acesso é de vocês para liberar. Só precisamos dele a tempo. Se demorar, o cronograma começa a contar a partir da liberação.</li>
                <li><b>A hospedagem atual comporta a entrega.</b> Conferimos no dia 1, sem custo. Se for preciso trocar de plano, dizemos na hora, com o custo na mesa, antes de qualquer coisa ser construída.</li>
                <li><b>As fotos são de vocês para usar.</b> As imagens enviadas precisam ser de uso autorizado, e qualquer paciente identificável precisa ter autorizado por escrito. Essa parte é da clínica, porque é ela quem tem a relação com a paciente.</li>
                <li><b>Uma pessoa decide.</b> Uma pessoa da Kira como ponto de contato, com autonomia para aprovar as duas etapas em até 1 dia útil. Num projeto de duas semanas, aprovação por comitê é o que mais atrasa.</li>
              </ul>
              <p class="disc__fine">
                A entrega contratada é o site novo, e não mexemos no site atual durante o projeto. Intervir
                nele cria acesso e responsabilidade sobre um sistema que não é a entrega. A exceção é a página
                Sobre: se o acesso estiver liberado no dia 1, trocamos os quatro cartões “Nome Sobrenome”
                pelos nomes reais como cortesia, sem cobrar, para isso não ficar no ar nem mais duas semanas.
              </p>
            </div>
          </details>

          <details class="disc">
            <summary>Perguntas que sempre aparecem <span class="disc__c" aria-hidden="true"></span></summary>
            <div class="disc__body">
              <p class="disc__sub">Dá para parcelar?</p>
              <p>O valor com os 12% de desconto é para pagamento à vista na assinatura. O desconto é a contrapartida. Se parcelar for necessário para fechar, fale comigo antes de assinar que a gente conversa sobre a condição.</p>
              <p class="disc__sub">Quem escreve os artigos do blog?</p>
              <p>Os textos das páginas e a reorganização dos 10 artigos existentes são nossos, assim como a pauta inicial e a diretriz editorial. Artigos novos mês a mês, depois da entrega, não estão incluídos: vocês publicam sozinhas, com o modelo pronto e o treinamento gravado. Todo artigo precisa sair assinado por um dentista com nome e registro. É regra do Conselho.</p>
              <p class="disc__sub">Eu consigo mudar as coisas depois, sem depender de vocês?</p>
              <p>Sim, e é assim que foi pensado. Publicar artigo, trocar foto, mudar texto de uma seção, trocar um botão da bio ou a ordem deles: tudo isso vocês fazem sozinhas, com o vídeo de passo a passo que entregamos.</p>
              <p class="disc__sub">E o domínio e a hospedagem? Vocês cobram alguma coisa?</p>
              <p>Não. Continuam contratados e pagos pela clínica, no nome dela, como já são hoje. A NOVRA não cobra nada por isso e não entra nessa relação. Todos os acessos ficam com vocês: nós usamos durante o projeto e devolvemos.</p>
              <p class="disc__sub">O que exatamente eu preciso enviar?</p>
              <p>Cinco coisas: as fotos que vocês já têm da clínica e da equipe; nome, formação e registro no CRO de cada profissional; a inscrição da clínica no Conselho e o nome e registro do responsável técnico; a confirmação do endereço e do horário; e os acessos do site e do domínio.</p>
            </div>
          </details>

        </div>

        <p class="pcomb__depois lead pretty" data-reveal>
          Mais para frente, essa base comporta a paciente marcar horário direto pelo site, o WhatsApp
          responder sozinho fora do horário e a clínica acompanhar quem pediu orçamento e não voltou.
          <strong class="text-bright">Nada disso está nesta proposta e nada disso tem custo aqui</strong>.
          Fica registrado só porque não vai precisar refazer o site para chegar lá.
        </p>
      </div>
    </section>

    <!-- ============ FECHAMENTO ============ -->
    <section class="section pcta">
      <span class="glow-orb pcta__orb" aria-hidden="true"></span>
      <div class="container">
        <div class="cta card" data-reveal>
          <i class="card-halo" aria-hidden="true"></i>
          <span class="eyebrow">Para começar</span>
          <h2 class="h2 balance cta__t">Três passos, e a agenda <span class="text-gradient">fica reservada.</span></h2>

          <ol class="cta__passos">
            <li><b>Aprovar.</b> Um retorno por escrito confirmando as três entregas, o valor de R$ 3.784 à vista e quem assina pela clínica. Com isso emitimos contrato e nota.</li>
            <li><b>Reunir o material.</b> Fotos, dados da equipe com registro, inscrição da clínica e do responsável técnico, endereço e horário, e os acessos. É a parte que define o prazo.</li>
            <li><b>Marcar o diagnóstico.</b> Uma hora, presencial ou online. Saímos dela com a data de publicação no calendário.</li>
          </ol>

          <div class="cta__actions">
            <a href={waLink} target="_blank" rel="noopener" class="btn btn-primary btn-lg" data-magnetic>
              Responder pelo WhatsApp
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <p class="cta__mail">{WHATSAPP_FMT} · <strong>contato@novratech.com.br</strong></p>
          </div>
        </div>
      </div>
    </section>

    <footer class="pfoot">
      <div class="container">
        <hr class="signature-line footer__sig" />
        <div class="pfoot__in">
          <p>
            <strong class="text-bright">NOVRA</strong> · Sistemas inteligentes para a próxima era<br />
            <a href="https://novratech.com.br" target="_blank" rel="noopener">novratech.com.br</a> · contato@novratech.com.br
          </p>
          <p class="pfoot__r">
            Proposta para Kira Odontologia<br />
            Emitida em {EMITIDA} · válida até {VALIDA_ATE}<br />
            Documento comercial, não é contrato
          </p>
        </div>
      </div>
