  </main>
</Base>

<style>
  /* ---------- cabeçalho enxuto ---------- */
  .phead { position: relative; z-index: 3; padding-block: 1.5rem; border-bottom: 1px solid var(--border); }
  .phead__in { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .phead__logo img { width: 128px; height: auto; }
  .phead__meta {
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--text-3);
  }

  /* ---------- hero ---------- */
  .phero { position: relative; z-index: 2; overflow: hidden; padding-block: clamp(3.5rem, 7vw, 6.5rem) clamp(2.5rem, 5vw, 4rem); }
  .phero__orb-a { top: -14%; left: -8%; width: 46vw; height: 46vw; max-width: 620px; max-height: 620px; background: var(--blue); animation: float-orb 17s ease-in-out infinite; }
  .phero__orb-b { top: 22%; right: -10%; width: 34vw; height: 34vw; max-width: 460px; max-height: 460px; background: var(--gold); opacity: 0.09; animation: float-orb 21s ease-in-out infinite reverse; }

  .phero__in {
    display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 4rem); align-items: center;
  }
  .phero__title { margin-top: 1.4rem; }
  .phero__lead { margin-top: 1.6rem; max-width: 54ch; }
  .phero__actions { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-top: 2.2rem; }

  /* mock de resultado de busca: a prova mais direta do diagnóstico */
  .serp {
    border: 1px solid var(--border-strong); border-radius: var(--r-md);
    background: linear-gradient(180deg, var(--bg-2), var(--bg-1));
    overflow: hidden; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
  }
  .serp__chrome {
    display: flex; align-items: center; gap: 0.4rem;
    padding: 0.7rem 0.9rem; background: var(--bg-3); border-bottom: 1px solid var(--border);
  }
  .serp__dot { width: 9px; height: 9px; border-radius: 50%; background: var(--border-strong); }
  .serp__tab {
    margin-left: 0.8rem; font-family: var(--font-mono); font-size: 0.74rem; color: var(--text-2);
    background: var(--bg-1); border: 1px solid var(--border); border-radius: 6px;
    padding: 0.22rem 0.9rem;
  }
  .serp__body { padding: 1.3rem 1.4rem 1.2rem; }
  .serp__url { font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-3); }
  .serp__title {
    font-family: var(--font-display); font-size: 1.5rem; font-weight: 500;
    color: #8fb6ff; margin-top: 0.25rem; letter-spacing: -0.01em;
  }
  .serp__desc { margin-top: 0.4rem; font-size: 0.9rem; }
  .serp__missing {
    color: var(--text-3); font-style: italic;
    border-bottom: 1px dashed var(--border-strong); padding-bottom: 2px;
  }
  .serp__note { margin-top: 0.9rem; font-size: 0.85rem; color: var(--text-3); line-height: 1.6; }
  .serp .hairline { margin-top: 1rem; }

  /* faixa de fatos */
  .facts {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 1px; background: var(--border); border: 1px solid var(--border);
    border-radius: var(--r-md); overflow: hidden; margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .facts__i { background: var(--bg-1); padding: 1.15rem 1.25rem; }
  .facts__i--hl { background: linear-gradient(180deg, rgba(46,107,255,0.12), var(--bg-1)); }
  .facts__i dt {
    font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--text-3);
  }
  .facts__i dd {
    font-family: var(--font-display); font-size: 1.2rem; font-weight: 600;
    color: var(--text-1); margin-top: 0.45rem; font-variant-numeric: tabular-nums;
  }
  .facts__i span { display: block; font-size: 0.8rem; color: var(--text-3); margin-top: 0.15rem; }

  /* ---------- diagnóstico ---------- */
  .pdiag { position: relative; z-index: 2; }
  .placar {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.1rem; margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .placar__i { padding: 1.6rem 1.5rem; }
  .placar__num {
    font-family: var(--font-display); font-size: clamp(2.6rem, 5vw, 3.6rem);
    font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums;
  }
  .placar__label { margin-top: 0.7rem; color: var(--text-1); font-weight: 500; line-height: 1.45; }
  .placar__det { margin-top: 0.6rem; font-size: 0.89rem; color: var(--text-3); line-height: 1.6; }

  .evid { margin-top: clamp(2.5rem, 5vw, 3.5rem); }
  .evid img { width: 100%; border: 1px solid var(--border); border-radius: var(--r-md); }
  .evid figcaption {
    margin-top: 1rem; font-size: 0.88rem; color: var(--text-3);
    line-height: 1.7; max-width: 70ch;
  }
  .evid figcaption strong { font-family: var(--font-mono); color: var(--gold); font-weight: 500; }
  .pdiag__close { margin-top: clamp(2rem, 4vw, 3rem); max-width: 68ch; }
  .pdiag__close em { font-style: normal; color: var(--text-3); font-size: 0.9em; }

  /* ---------- entregas ---------- */
  .pentregas { position: relative; z-index: 2; overflow: hidden; }
  .pentregas__orb { top: 10%; right: -12%; width: 42vw; height: 42vw; max-width: 560px; max-height: 560px; background: var(--blue); }
  .ent__grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 1.3rem; margin-top: clamp(2.5rem, 5vw, 3.5rem); align-items: start;
  }
  .ent { padding: 1.8rem 1.6rem; display: flex; flex-direction: column; }
  .ent__top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .ent__n {
    font-family: var(--font-mono); font-size: 0.78rem; color: var(--gold);
    border: 1px solid var(--border-gold); border-radius: var(--r-pill); padding: 0.2rem 0.75rem;
  }
  .ent__preco { font-family: var(--font-mono); font-size: 0.95rem; color: var(--text-1); }
  .ent__titulo { font-size: var(--fs-h4); margin-top: 1.1rem; }
  .ent__resumo { margin-top: 0.8rem; font-size: 0.95rem; line-height: 1.65; }
  .ent__dest { margin-top: 1.2rem; display: grid; gap: 0.5rem; }
  .ent__dest li {
    position: relative; padding-left: 1.4rem; font-size: 0.9rem; color: var(--text-2); line-height: 1.55;
  }
  .ent__dest li::before {
    content: ""; position: absolute; left: 0; top: 0.5em;
    width: 8px; height: 4px; border-left: 1.5px solid var(--cyan-500); border-bottom: 1.5px solid var(--cyan-500);
    transform: rotate(-45deg);
  }
  .ent__disc { margin-top: auto; padding-top: 1.3rem; }

  /* ---------- disclosure (acordeão) ---------- */
  .disc { border-top: 1px solid var(--border); }
  .disc:first-child { border-top: 0; }
  .disc > summary {
    list-style: none; cursor: pointer; display: flex; align-items: center; gap: 1rem;
    padding: 1.15rem 0; font-family: var(--font-display); font-weight: 500;
    color: var(--text-1); font-size: 1rem;
    transition: color 0.3s var(--ease-out);
  }
  .disc > summary::-webkit-details-marker { display: none; }
  .disc > summary:hover { color: var(--cyan-400); }
  .disc__c {
    margin-left: auto; position: relative; width: 14px; height: 14px; flex: none;
  }
  .disc__c::before, .disc__c::after {
    content: ""; position: absolute; left: 0; top: 6px; width: 14px; height: 2px;
    background: var(--gold); border-radius: 2px; transition: transform 0.35s var(--ease-out);
  }
  .disc__c::after { transform: rotate(90deg); }
  .disc[open] > summary { color: var(--gold-light); }
  .disc[open] .disc__c::after { transform: rotate(0deg); }
  .disc__body, .disc__list { padding-bottom: 1.5rem; }
  .disc__body > p { margin-bottom: 0.9rem; font-size: 0.94rem; line-height: 1.7; }
  .disc__sub {
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--text-3); margin: 1.4rem 0 0.7rem !important;
  }
  .disc__sub--yes { color: var(--cyan-400); }
  .disc__sub--no { color: var(--text-3); }
  .disc__list { display: grid; gap: 0.6rem; }
  .disc__list li {
    position: relative; padding-left: 1.5rem; font-size: 0.92rem;
    color: var(--text-2); line-height: 1.65;
  }
  .disc__list li::before {
    content: ""; position: absolute; left: 0; top: 0.52em;
    width: 8px; height: 4px; border-left: 1.5px solid var(--cyan-500); border-bottom: 1.5px solid var(--cyan-500);
    transform: rotate(-45deg);
  }
  .disc__list--no li::before {
    border: 0; background: var(--text-3); width: 9px; height: 1.5px; transform: none; top: 0.72em;
  }
  .disc__list b, .etapas b { color: var(--text-1); font-weight: 600; }
  .disc__fine {
    margin-top: 1.2rem; font-size: 0.84rem; color: var(--text-3);
    line-height: 1.7; border-left: 1px solid var(--border); padding-left: 1rem;
  }
  .etapas { display: grid; gap: 0.9rem; padding-bottom: 0.4rem; }
  .etapas li { font-size: 0.93rem; color: var(--text-2); line-height: 1.65; }
  .duo { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.6rem; }
  .duo > div { min-width: 0; }
  .comb {
    margin-top: clamp(2.2rem, 4vw, 3rem);
    border: 1px solid var(--border); border-radius: var(--r-lg);
    padding: 0.4rem clamp(1.2rem, 3vw, 2rem); background: var(--surface);
  }
  .pcomb__depois { margin-top: clamp(2rem, 4vw, 3rem); max-width: 70ch; }

  /* ---------- case ---------- */
  .pcase { position: relative; z-index: 2; }
  .case__grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.3rem; margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .case { padding: 1.1rem; display: block; }
  .case__shot {
    display: block; border-radius: var(--r-sm); overflow: hidden;
    border: 1px solid var(--border); background: var(--bg-2);
    aspect-ratio: 16 / 10;
  }
  .case__shot img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .case__t { font-size: 1.05rem; margin-top: 1.1rem; }
  .case__d { font-size: 0.88rem; color: var(--text-3); margin-top: 0.4rem; line-height: 1.55; }
  .case__l { margin-top: 0.9rem; font-family: var(--font-mono); font-size: 0.78rem; }

  /* ---------- investimento ---------- */
  .pinvest { position: relative; z-index: 2; overflow: hidden; scroll-margin-top: 80px; }
  .pinvest__orb { top: 4%; left: 50%; transform: translateX(-50%); width: 52vw; height: 52vw; max-width: 680px; max-height: 680px; background: var(--gold); opacity: 0.1; }
  .invest { max-width: 680px; margin-inline: auto; padding: clamp(1.8rem, 4vw, 3rem); }
  .invest__head { text-align: center; }
  .invest__head .eyebrow::before { display: none; }
  .invest__sub { margin-top: 0.8rem; color: var(--text-3); font-size: 0.92rem; }
  .invest__linhas { margin-top: 2rem; display: grid; }
  .invest__linhas li {
    display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
